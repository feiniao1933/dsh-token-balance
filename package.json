{
  "name": "dsh-token-balance",
  "version": "1.0.1",
  "description": "Shows the DeepSeek account balance (recharge + bonus) below the composer in DeepSeek Harness and keeps it up to date.",
  "type": "module",
  "license": "MIT",
  "author": "Poboy <feiniao1933@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feiniao1933/dsh-token-balance.git"
  },
  "homepage": "https://github.com/feiniao1933/dsh-token-balance#readme",
  "bugs": {
    "url": "https://github.com/feiniao1933/dsh-token-balance/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "balance",
    "tokens",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
